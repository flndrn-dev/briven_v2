[Unit]
Description=Export Briven PostgreSQL public TLS certificate
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/briven/export-public-proxy-certificate.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/briven/public-postgres-tls
