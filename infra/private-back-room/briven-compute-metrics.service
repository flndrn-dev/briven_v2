[Unit]
Description=Briven read-only aggregate compute accounting

[Service]
Type=oneshot
User=briven-metrics
Group=briven-metrics
RuntimeDirectory=briven-compute-metrics
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /usr/local/libexec/briven/compute-resource-metrics.py
TimeoutStartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
MemoryMax=32M
TasksMax=16
UMask=0022
